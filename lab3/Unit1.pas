unit Unit1;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls;

type
  TForm1 = class(TForm)
    ButtonEncrypt: TButton;
    ButtonDecrypt: TButton;
    OpenDialog1: TOpenDialog;
    SaveDialog1: TSaveDialog;
    Memo1: TMemo;
    procedure ButtonEncryptClick(Sender: TObject);
    procedure ButtonDecryptClick(Sender: TObject);
  private
    { Private declarations }
    function Rnd(var Y: Integer): Integer;
    procedure EncryptDecrypt(const InputFile, OutputFile: string);
  public
    { Public declarations }
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}

const
  a = 5;       // ?????????
  m = 4096;    // ??????
  Y0 = 4003;   // ????????? ????????

// ??????? ????????? ???????????????? ?????
function TForm1.Rnd(var Y: Integer): Integer;
begin
  Y := (a * Y) mod m;
  Result := Y;
end;

// ????????? ??????????/????????????
procedure TForm1.EncryptDecrypt(const InputFile, OutputFile: string);
var
  Fin, Fout: file of Byte;
  P, C, G: Byte;
  Y: Integer;
begin
  AssignFile(Fin, InputFile);
  AssignFile(Fout, OutputFile);
  Reset(Fin);
  Rewrite(Fout);

  Y := Y0; // ????????????? ?????????? ????????
  while not Eof(Fin) do
  begin
    Read(Fin, P);
    G := Rnd(Y) mod 256; // ????????? ?????
    C := P xor G;        // ??????????/????????????
    Write(Fout, C);
  end;

  CloseFile(Fin);
  CloseFile(Fout);

  Memo1.Lines.Add('???? ??????? ?????????: ' + OutputFile);
end;

// ?????????? ??????? ?? ?????? "???????????"
procedure TForm1.ButtonEncryptClick(Sender: TObject);
begin
  if OpenDialog1.Execute then
  begin
    if SaveDialog1.Execute then
    begin
      EncryptDecrypt(OpenDialog1.FileName, SaveDialog1.FileName);
    end;
  end;
end;

// ?????????? ??????? ?? ?????? "????????????"
procedure TForm1.ButtonDecryptClick(Sender: TObject);
begin
  if OpenDialog1.Execute then
  begin
    if SaveDialog1.Execute then
    begin
      EncryptDecrypt(OpenDialog1.FileName, SaveDialog1.FileName);
    end;
  end;
end;

end.
