unit Unit2;

interface

uses
  SysUtils;

function ShuffleBits(const Input: Byte): Byte;
function EncryptText(const Text: string): string;
function DecryptText(const EncryptedText: string): string;

implementation

// ??????? ??? ???????????? ??? ? ?????
function ShuffleBits(const Input: Byte): Byte;
begin
  // ?????? ???????????? ???: ?????? ??????? ???? 0 ? 7, 1 ? 6, 2 ? 5, 3 ? 4
  Result := ((Input and $01) shl 7) or
            ((Input and $02) shl 5) or
            ((Input and $04) shl 3) or
            ((Input and $08) shl 1) or
            ((Input and $10) shr 1) or
            ((Input and $20) shr 3) or
            ((Input and $40) shr 5) or
            ((Input and $80) shr 7);
end;

// ??????? ??? ?????????? ??????
function EncryptText(const Text: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(Text) do
  begin
    Result := Result + Chr(ShuffleBits(Ord(Text[i])));
  end;
end;

// ??????? ??? ???????????? ??????
function DecryptText(const EncryptedText: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(EncryptedText) do
  begin
    Result := Result + Chr(ShuffleBits(Ord(EncryptedText[i])));
  end;
end;

end. 
