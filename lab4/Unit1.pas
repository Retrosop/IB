unit Unit1;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls;

type
  TForm1 = class(TForm)
    ButtonEncrypt: TButton;
    ButtonDecrypt: TButton;
    OpenDialog1: TOpenDialog;
    SaveDialog1: TSaveDialog;
    Memo1: TMemo;
    procedure ButtonEncryptClick(Sender: TObject);
    procedure ButtonDecryptClick(Sender: TObject);
  private
    { Private declarations }
    procedure VernamCipher(const InputFile, OutputFile: string);
  public
    { Public declarations }
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}

const
  KeyLength = 5; // ????? ?????
  Key: array[0..KeyLength-1] of Byte = (12, 34, 56, 78, 90); // ????

// ????????? ??????????/???????????? ??????? ???????
procedure TForm1.VernamCipher(const InputFile, OutputFile: string);
var
  Fin, Fout: file of Byte;
  P, C, K: Byte;
  KeyIndex: Integer;
begin
  AssignFile(Fin, InputFile);
  AssignFile(Fout, OutputFile);
  Reset(Fin);
  Rewrite(Fout);

  KeyIndex := 0; // ?????? ??? ???????????? ????????????? ?????
  while not Eof(Fin) do
  begin
    Read(Fin, P); // ?????? ????? ?? ????????? ?????
    K := Key[KeyIndex]; // ????????? ???????? ????? ?????
    C := P xor K; // ??????????/????????????
    Write(Fout, C); // ?????? ?????????? ? ???????? ????

    KeyIndex := (KeyIndex + 1) mod KeyLength; // ??????????? ????????????? ?????
  end;

  CloseFile(Fin);
  CloseFile(Fout);

  Memo1.Lines.Add('???? ??????? ?????????: ' + OutputFile);
end;

// ?????????? ??????? ?? ?????? "???????????"
procedure TForm1.ButtonEncryptClick(Sender: TObject);
begin
  if OpenDialog1.Execute then
  begin
    if SaveDialog1.Execute then
    begin
      VernamCipher(OpenDialog1.FileName, SaveDialog1.FileName);
    end;
  end;
end;

// ?????????? ??????? ?? ?????? "????????????"
procedure TForm1.ButtonDecryptClick(Sender: TObject);
begin
  if OpenDialog1.Execute then
  begin
    if SaveDialog1.Execute then
    begin
      VernamCipher(OpenDialog1.FileName, SaveDialog1.FileName);
    end;
  end;
end;

end.
